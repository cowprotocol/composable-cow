# Network to deploy to, and the account paying for it. Left blank on purpose: every script here
# takes --rpc-url, and a live chain sitting in the default is one stray --broadcast from a real
# deployment. For local runs point it at anvil, http://127.0.0.1:8545.
ETH_RPC_URL=
PRIVATE_KEY=

# Contract verification on block explorers, used by dev/verify-contracts.sh
#ETHERSCAN_API_KEY=

# CoW Settlement (GPv2Settlement). Required by every deployment script, including the ones that
# only name COMPOSABLE_COW: it is what the ComposableCoW behind that address is checked against.
SETTLEMENT=0x9008D19f58AAbD9eD0D60971565AA8510560ab41

# ComposableCoW (canonical)
COMPOSABLE_COW=0xfdaFc9d1902f4e0b84f65F49f244b32b31013b74

# CowShed factory. Required by every script that deploys the poller: `ComposableCowPoller` pins it
# immutably, and only proxies from this factory may manage a funder's schedules.
COW_SHED_FACTORY=0x00E989b87700514118Fa55326CD1cCE82faebEF6

# CREATE2 salt
#SALT=v1.0.0

# Order submission, used by script/submit_SingleOrder.s.sol alongside COMPOSABLE_COW
#SAFE=
#TWAP=

# Canonical deployment flag, read by `script/deploy_All.s.sol`:
#   - `CANONICAL=true` (default): skip the legacy contracts, expecting `dev/deploy-canonical.sh` to have deployed them.
#   - `CANONICAL=false`: deploy them from the current code with CREATE2 and SALT, landing on different addresses.
# More details in `canonical/README.md`.
#CANONICAL=false
